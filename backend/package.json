{
  "name": "attendance-hub",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute attendance-hub-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute attendance-hub-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute attendance-hub-db --local --file=./seed.sql",
    "db:backup": "wrangler d1 export attendance-hub-db --remote --output=backup.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^4.20250101.0"
  },
  "dependencies": { "xlsx": "^0.18.5" }
}
